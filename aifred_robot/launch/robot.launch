<?xml version="1.0"?>
<!-- Raspberry Pi (connected to the arm): driver + robot description + TF.
     roslaunch aifred_robot robot.launch -->
<launch>
  <param name="wx250s/robot_description" command="xacro '$(find aifred_robot)/urdf/aifred.urdf.xacro'"/>

  <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" ns="wx250s"/>

  <node name="xs_sdk" pkg="interbotix_xs_sdk" type="xs_sdk" output="screen" ns="wx250s">
    <param name="motor_configs" value="$(find aifred_robot)/config/wx250s_aifred.yaml"/>
    <param name="mode_configs"  value="$(find aifred_robot)/config/modes.yaml"/>
    <param name="load_configs"  value="true"/>
  </node>
</launch>
