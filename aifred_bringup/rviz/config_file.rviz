Panels:
  - Class: rviz/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /RobotModel1
        - /Image1
      Splitter Ratio: 0.5777778029441833
    Tree Height: 226
  - Class: rviz/Selection
    Name: Selection
  - Class: rviz/Tool Properties
    Expanded:
      - /2D Pose Estimate1
      - /2D Nav Goal1
      - /Publish Point1
    Name: Tool Properties
    Splitter Ratio: 0.5886790156364441
  - Class: rviz/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
  - Class: rviz/Time
    Name: Time
    SyncMode: 0
    SyncSource: Image
  - Class: interbotix_xs_rviz/Interbotix Control Panel
    Name: Interbotix Control Panel
    RobotNameSpace: aifred
Preferences:
  PromptSaveOnExit: true
Toolbars:
  toolButtonStyle: 2
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.699999988079071
      Cell Size: 0.25
      Class: rviz/Grid
      Color: 255; 255; 255
      Enabled: true
      Line Style:
        Line Width: 0.029999999329447746
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 10
      Reference Frame: <Fixed Frame>
      Value: true
    - Alpha: 0.4000000059604645
      Class: rviz/RobotModel
      Collision Enabled: false
      Enabled: true
      Links:
        All Links Enabled: true
        Expand Joint Details: false
        Expand Link Details: false
        Expand Tree: false
        Link Tree Style: Links in Alphabetic Order
        aifred/base_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        aifred/camera_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        aifred/ee_camera_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
        aifred/head_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        aifred/head_mount_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        aifred/lower_forearm_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        aifred/projector_lens_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        aifred/projector_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        aifred/shoulder_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        aifred/upper_arm_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        aifred/upper_forearm_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        aifred/webcam_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        aifred/wrist_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        world:
          Alpha: 1
          Show Axes: false
          Show Trail: false
      Name: RobotModel
      Robot Description: robot_description
      TF Prefix: ""
      Update Interval: 0
      Value: true
      Visual Enabled: true
    - Class: rviz/TF
      Enabled: true
      Filter (blacklist): ""
      Filter (whitelist): ""
      Frame Timeout: 15
      Frames:
        All Enabled: false
        aifred/base_link:
          Value: true
        aifred/camera_link:
          Value: true
        aifred/ee_camera_link:
          Value: true
        aifred/head_link:
          Value: true
        aifred/head_mount_link:
          Value: true
        aifred/lower_forearm_link:
          Value: true
        aifred/projector_lens_link:
          Value: true
        aifred/projector_link:
          Value: true
        aifred/shoulder_link:
          Value: true
        aifred/upper_arm_link:
          Value: true
        aifred/upper_forearm_link:
          Value: true
        aifred/webcam_link:
          Value: true
        aifred/wrist_link:
          Value: true
        world:
          Value: true
      Marker Alpha: 1
      Marker Scale: 0.05000000074505806
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Tree:
        world:
          aifred/base_link:
            aifred/shoulder_link:
              aifred/upper_arm_link:
                aifred/upper_forearm_link:
                  aifred/lower_forearm_link:
                    aifred/wrist_link:
                      aifred/head_mount_link:
                        aifred/head_link:
                          aifred/projector_link:
                            aifred/projector_lens_link:
                              {}
                          aifred/webcam_link:
                            aifred/camera_link:
                              aifred/ee_camera_link:
                                {}
      Update Interval: 0
      Value: true
    - Class: rviz/Image
      Enabled: true
      Image Topic: /aifred_cam/image_raw
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: Image
      Normalize Range: true
      Queue Size: 2
      Transport Hint: raw
      Unreliable: false
      Value: true
  Enabled: true
  Global Options:
    Background Color: 0; 176; 240
    Default Light: true
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
    - Class: rviz/SetInitialPose
      Theta std deviation: 0.2617993950843811
      Topic: /initialpose
      X std deviation: 0.5
      Y std deviation: 0.5
    - Class: rviz/SetGoal
      Topic: /move_base_simple/goal
    - Class: rviz/PublishPoint
      Single click: true
      Topic: /clicked_point
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 0.8986436724662781
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.05999999865889549
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Field of View: 0.7853981852531433
      Focal Point:
        X: -0.12742657959461212
        Y: -0.04729577153921127
        Z: 0.15013176202774048
      Focal Shape Fixed Size: false
      Focal Shape Size: 0.05000000074505806
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.009999999776482582
      Pitch: 0.2003984898328781
      Target Frame: <Fixed Frame>
      Yaw: 1.5603983402252197
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 1016
  Hide Left Dock: false
  Hide Right Dock: false
  Image:
    collapsed: false
  Interbotix Control Panel:
    collapsed: false
  QMainWindow State: 
  Selection:
    collapsed: false
  Time:
    collapsed: false
